Options -Indexes
RewriteEngine On

# Redirect /index.html → /
RewriteRule ^index\.html$ / [R=301,L]

# Redirect /page.html → /page (removes .html from address bar)
RewriteCond %{THE_REQUEST} \s/+([^.?\s]+)\.html[\s?] [NC]
RewriteRule ^ /%1 [R=301,L]

# Internally serve /page → /page.html (no visible redirect)
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^([^.]+?)/?$ $1.html [L]

# Strip trailing slashes on non-root pages
RewriteRule ^(.+)/$ /$1 [R=301,L]
